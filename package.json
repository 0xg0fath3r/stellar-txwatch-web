{
  "name": "stellar-txwatch-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"if(process.env.SENTRY_AUTH_TOKEN){process.exit(0)}else{process.exit(0)}\" && npm run sentry:sourcemaps --if-present",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "sentry:sourcemaps": "node -e \"if(!process.env.SENTRY_AUTH_TOKEN){console.log('SENTRY_AUTH_TOKEN not set; skipping source map upload');process.exit(0)}require('child_process').execSync('npx @sentry/cli sourcemaps upload --org \\\"'+(process.env.SENTRY_ORG||'')+'\\\" --project \\\"'+(process.env.SENTRY_PROJECT||'')+'\\\" .next',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@sentry/nextjs": "^7.114.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}